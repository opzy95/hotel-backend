PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/hotel_backend?replicaSet=rs0
JWT_SECRET=replace-with-at-least-32-random-characters
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
BREVO_API_KEY=replace-with-your-brevo-api-key
BREVO_SENDER_EMAIL=no-reply@example.com
BREVO_SENDER_NAME=Hotel Platform
FRONTEND_URL=http://localhost:5173
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
CLOUDINARY_CLOUD_NAME=replace-with-your-cloudinary-cloud-name
CLOUDINARY_API_KEY=replace-with-your-cloudinary-api-key
CLOUDINARY_API_SECRET=replace-with-your-cloudinary-api-secret
